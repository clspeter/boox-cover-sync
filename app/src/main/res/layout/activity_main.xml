<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BOOX Cover Sync"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="開啟 App 時會查詢 NeoReader 最近閱讀紀錄並同步一次；也可以按鈕重試。"
            android:textSize="16sp" />

        <Button
            android:id="@+id/sync_latest_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sync_latest_button" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/latest_cover_waiting"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="自動同步"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="背景自動同步是選用功能；手動開啟 App 同步不需要無障礙服務。下方權限狀態僅供背景同步與診斷參考。"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/auto_sync_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="啟用自動同步" />

        <TextView
            android:id="@+id/auto_sync_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="自動同步狀態：檢查中…"
            android:textSize="13sp" />

        <Button
            android:id="@+id/accessibility_settings_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開啟 Accessibility 設定" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="手動同步不需要無障礙服務。背景同步是否能持續，取決於無障礙服務與 BOOX 背景執行設定；DUMP／Usage Access 僅供診斷參考。"
            android:textSize="12sp" />

        <Button
            android:id="@+id/open_epub_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="選擇 EPUB" />

        <TextView
            android:id="@+id/selected_file_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="尚未選擇檔案"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/cover_preview"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:background="#EEEEEE"
            android:contentDescription="封面預覽"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/book_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="封面：尚未解析（不顯示書籍資訊）"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sleep_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="同步休眠畫面（type=16）" />

        <Switch
            android:id="@+id/shutdown_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="同步關機畫面（type=17）" />

        <Button
            android:id="@+id/sync_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="立即重新同步" />

        <TextView
            android:id="@+id/storage_permission_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="公共儲存空間權限：檢查中…"
            android:textSize="13sp" />

        <Button
            android:id="@+id/storage_permission_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開啟公共儲存空間設定"
            android:visibility="gone" />

        <TextView
            android:id="@+id/library_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="書庫權限：使用 Android 檔案選擇器授權"
            android:textSize="13sp" />

        <Button
            android:id="@+id/usage_access_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="開啟 Usage Access 設定" />

        <TextView
            android:id="@+id/background_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="背景執行：請在 BOOX 設定中允許本 App 執行"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
